# ---------- Model / runtime ----------
INSIGHTFACE_MODEL=buffalo_l
# Docker image sets this to /models; this value is for local runs
INSIGHTFACE_ROOT=~/.insightface
DEVICE=auto
DETECTION_SIZE=1280
DETECTION_MIN_SIZE=640
DETECTION_THRESHOLD=0.5
DETECTION_LOW_THRESHOLD=0.3
DETECTION_TILING=true
DETECTION_TILE_SIDE=1600
DETECTION_TILE_OVERLAP=0.25
WARMUP=true
# Tune to your CPU/GPU and RAM. Shared by /analyze-classroom and /generate-embedding.
MAX_CONCURRENT_INFERENCES=1
INFERENCE_QUEUE_TIMEOUT=120

# ---------- Matching thresholds (calibrate with real data before changing) ----------
HIGH_CONFIDENCE_THRESHOLD=0.55
REVIEW_THRESHOLD=0.45
MIN_MATCH_MARGIN=0.05
CONTESTED_REVIEW_GAP=0.10
CANDIDATE_COUNT=3
UNKNOWN_CLUSTER_THRESHOLD=0.5
MIN_EMBED_FACE_SIDE=20
HIGH_REQUIRES_GOOD_IMAGE=true
GALLERY_POOLING=max
# Changing EMBED_FLIP or GALLERY_POOLING after enrolment makes new matches differ from how stored embeddings were made.
EMBED_FLIP=false

# ---------- Request limits / auth ----------
MAX_IMAGE_BYTES=10485760
MAX_IMAGE_PIXELS=50000000
MAX_IMAGES_PER_REQUEST=5
MAX_STUDENTS_PER_REQUEST=2000
# Required: the service will not start with an empty key.
API_KEY=
# Set true once every client sends embeddingModel.
REQUIRE_EMBEDDING_MODEL=false

# ---------- Whole-image quality ----------
IMAGE_MIN_SHORT_SIDE=320
IMAGE_RECOMMENDED_SHORT_SIDE=600
IMAGE_BLUR_POOR=100
IMAGE_BRIGHTNESS_UNUSABLE_LOW=0.08
IMAGE_BRIGHTNESS_POOR_LOW=0.20
IMAGE_BRIGHTNESS_POOR_HIGH=0.85
IMAGE_BRIGHTNESS_UNUSABLE_HIGH=0.96

# ---------- Per-face quality ----------
FACE_REJECT_MIN_SIDE=20
FACE_HIGH_MIN_SIDE=40
FACE_TARGET_SIDE=80
FACE_REJECT_MIN_SHARPNESS=0.10
FACE_HIGH_MIN_SHARPNESS=0.25
FACE_TARGET_SHARPNESS=0.45
FACE_REJECT_BRIGHTNESS_LOW=0.06
FACE_REJECT_BRIGHTNESS_HIGH=0.96
FACE_HIGH_MIN_FRONTALNESS=0.30
FACE_HIGH_MIN_QUALITY=0.50

# ---------- Enrolment / reference photos ----------
REFERENCE_MIN_FACE_SIDE=96
REFERENCE_MIN_FACE_SHARPNESS=0.30
REFERENCE_MIN_FRONTALNESS=0.50
REFERENCE_SECONDARY_FACE_AREA_RATIO=0.15
REFERENCE_PAD_FALLBACK=true

# ---------- Debug / logging ----------
SAVE_FACE_CROPS=false
# Docker image sets this to /app/storage/face-crops
FACE_CROP_DIR=storage/face-crops
LOG_LEVEL=INFO
