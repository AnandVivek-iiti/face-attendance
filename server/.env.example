PORT=5000
MONGODB_URI=mongodb://localhost:27017/face_attendance
# REQUIRED. Generate a unique value per environment, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Never commit the real value. Anyone who knows it can forge a login for any user.
JWT_SECRET=replace-with-a-long-random-secret
ML_SERVICE_URL=http://localhost:8000
# Optional: only when the ML service has API_KEY set.
# ML_API_KEY=
CLIENT_URL=http://localhost:5173
UPLOAD_MAX_SIZE=10485760
# Set to the number of reverse proxies in front of this server (e.g. 1 behind
# nginx / a load balancer). Needed so rate limiting sees the real client IP.
# TRUST_PROXY=1
# Students may create an account just by logging in with an unused address. That
# lets anyone claim someone else's address first, so it is OFF in production
# unless you opt in. Students can still sign in with Google (proves ownership).
# ALLOW_SELF_REGISTRATION=false
# Google OAuth (optional: set both to enable "Sign in with Google").
# Server-side only - the secret must NEVER be exposed to the client bundle.
# The callback must be registered EXACTLY under "Authorized redirect URIs" in
# the Google Cloud console, or Google returns redirect_uri_mismatch.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Relative is resolved against the request host; set the absolute
# public URL when running behind a proxy, e.g.
# GOOGLE_CALLBACK_URL=https://api.example.com/api/auth/google/callback
