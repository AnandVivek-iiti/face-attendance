PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/face_attendance
JWT_SECRET=
JWT_EXPIRES_IN=8h
ML_SERVICE_URL=http://localhost:8000
ML_API_KEY=
ML_TIMEOUT_MS=60000
ML_RETRY_ATTEMPTS=3
ML_RETRY_DELAY_MS=1000
# Defence in depth. Node never marks a student Present on the ML service's word alone: a "high_confidence" face is sent to review
# unless its similarity and match margin ALSO clear these floors (the stricter of these and the ML service's own policy wins).
# Defaults equal the ML service's HIGH_CONFIDENCE_THRESHOLD / MIN_MATCH_MARGIN. If you calibrate the ML thresholds, change these too.
AUTO_PRESENT_MIN_SIMILARITY=0.55
AUTO_PRESENT_MIN_MARGIN=0.05
# A professor's face assignment adds that classroom face as a reference vector only when true (a student with no reference vector
# always gets one, otherwise they could never be recognised). When true, it also requires an ML-suggested match at/above this value.
ASSIGN_APPENDS_EMBEDDING=false
ASSIGN_APPEND_MIN_SIMILARITY=0.55
# Legacy filesystem storage (attendance photos, temp uploads, not-yet-migrated registered photos). Point at a PERSISTENT volume in
# production; platforms such as Render wipe the container disk on every deploy. Registered photos live in MongoDB GridFS instead.
STORAGE_ROOT=
CLIENT_URL=http://localhost:5173
UPLOAD_MAX_SIZE=10485760
TRUST_PROXY=0
ALLOW_SELF_REGISTRATION=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
SERVER_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
RESEND_API_KEY=
SENDGRID_API_KEY=
BREVO_API_KEY=
EMAIL_PROVIDER=
EMAIL_LINK_TTL_MINUTES=30
