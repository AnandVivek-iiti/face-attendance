# Server origin. Used for API calls AND the "Continue with Google" redirect, so
# it must be an absolute URL in production (the static host has no /api proxy).
VITE_API_BASE_URL=http://localhost:5000
# Origin that serves /api/files images (usually the same server).
VITE_ASSET_BASE_URL=http://localhost:5000
# Dev-only: Vite proxies /api here.
VITE_DEV_PROXY_TARGET=http://localhost:5000
